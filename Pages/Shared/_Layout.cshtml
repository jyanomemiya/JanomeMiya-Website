<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - APSNETテスト</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/APSNETテスト.styles.css" asp-append-version="true" />
    <!-- カリグラフィー筆記体（Pinyon Script）と、上品な日本語（Noto Serif JP）を読み込む -->
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Noto+Serif+Japanese:wght@300;500;700&family=Pinyon+Script&display=swap" rel="stylesheet">

    <style>
        body {
            background-color: #faf9f6 !important;
            color: #2c3e50 !important;
            font-family: 'Noto Serif Japanese', serif !important; /* 日本語は上品な細身の明朝 */
            font-weight: 300;
            /* 英語を太めで力強いカリグラフィー筆記体にする設定 */
            .cursive-font
        {
            font-family: 'Pinyon Script', cursive !important;
            font-size: 4rem !important; /* 力強く見せるために少し大きめに調整 */
            font-weight: 700 !important; /* 太さを強調 */
            color: #b32424; /* 神使の赤 */
            letter-spacing: 1px;
        }


        /* ナビゲーションバー */
        .navbar {
            background-color: #ffffff !important;
            border-bottom: 3px solid #d4af37 !important; /* 神々しい金色（ゴールド）のライン */
        }

        .navbar-brand {
            color: #b32424 !important; /* 鳥居の朱赤 */
            font-weight: bold;
            letter-spacing: 2px;
        }
        /* カード（神聖な白、少し浮き上がる影） */
        .card {
            background-color: #ffffff !important;
            border: 1px solid #e6dfd3 !important;
            box-shadow: 0 4px 15px rgba(179, 36, 36, 0.03) !important; /* ほんのり朱色の影 */
            border-radius: 4px !important; /* 和風に合わせて角を少しシャープに */
        }
        /* ボタン（厳かな朱赤） */
        .btn-primary {
            background-color: #b32424 !important;
            border-color: #b32424 !important;
            color: #ffffff !important;
        }

            .btn-primary:hover {
                background-color: #8a1c1c !important;
                border-color: #8a1c1c !important;
            }

        .btn-outline-primary {
            color: #b32424 !important;
            border-color: #b32424 !important;
        }

            .btn-outline-primary:hover {
                background-color: #b32424 !important;
                color: #ffffff !important;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">蛇之眼ミヤ</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - APSNETテスト - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>